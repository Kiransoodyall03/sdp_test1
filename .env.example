# Repo Analysis Tool configuration.
# Copy to `.env` and adjust if needed. No secrets are required to run this app.

# Server
PORT=3000
NODE_ENV=development

# Storage (relative paths resolve from the project root; absolute paths allowed)
DATA_DIR=data
DB_PATH=data/rat.sqlite
UPLOAD_TMP_DIR=data/tmp/uploads
REPO_STORE_DIR=data/repos

# Ingestion limits
MAX_UPLOAD_MB=200
MAX_EXTRACTED_MB=1000
MAX_ZIP_ENTRIES=200000
MAX_ZIP_DEPTH=64
GIT_TIMEOUT_MS=120000
GIT_RENAME_THRESHOLD=50%
